{
    "name": "andrewgjohnson/linebreaks4imagettftext",
    "type": "library",
    "description": "linebreaks4imagettftext is a function to automatically insert line breaks into your text while using PHP’s imagettftext() function",
    "keywords": [
        "gd",
        "graphics",
        "image",
        "images"
    ],
    "homepage": "https://linebreaks4imagettftext.agjgd.org",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrew G Johnson",
            "email": "andrew@andrewgjohnson.com",
            "homepage": "https://www.andrewgjohnson.com/",
            "role": "Project Lead"
        }
    ],
    "require": {
        "php": ">=8.0.0",
        "ext-gd": "*",
        "andrewgjohnson/agjgd": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "files": [
            "source/AndrewGJohnson/AgjGd/linebreaks4imagettftext.php",
            "source/reverseCompatibility.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AndrewGJohnson\\Linebreaks4imagettftext\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "@php vendor/bin/phpcs",
        "lint:fix": "@php vendor/bin/phpcbf",
        "phpunit": "@php vendor/bin/phpunit",
        "test": [
            "@lint",
            "@phpunit"
        ]
    }
}
